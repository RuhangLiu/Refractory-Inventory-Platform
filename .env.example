# Local and managed-runtime configuration
PORT=8080
GCP_PROJECT_ID=your-gcp-project-id
BQ_DATASET=refractory_inventory
BQ_LOCATION=US
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash

# Public application -> deployed Vertex AI Agent Engine proxy
# Leave unset for the local grounded development fallback.
AGENT_ENGINE_RESOURCE=projects/1052614770067/locations/us-west1/reasoningEngines/7636161031462453248
AGENT_ENGINE_MODEL=gemini-3.1-pro-preview
AGENT_ENGINE_TIMEOUT_MS=180000
